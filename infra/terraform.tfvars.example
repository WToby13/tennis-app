# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.

aws_region = "eu-west-1"
project    = "tennis"

# Add your deployed web origin here once you have it (keep localhost for dev).
allowed_origins = [
  "http://localhost:3000",
  # "https://your-app.vercel.app",
]

# --- Analysis-proxy transcoder ------------------------------------------------
# The Fargate task sets one column in Supabase when a proxy is ready, so it needs
# these. Same values as web/.env — the URL is public, the service-role key is not.
supabase_url              = "https://<project-ref>.supabase.co"
supabase_service_role_key = "<service role key>"
