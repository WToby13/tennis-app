# --- Storage backend ---------------------------------------------------------
# "local" writes parts/videos to web/.data (no cloud account needed — the default).
# "s3" uses real S3 multipart with presigned URLs + signed CloudFront playback.
STORAGE_BACKEND=local

# Size of each multipart chunk in bytes. S3 minimum is 5 MB (except the last part).
PART_SIZE_BYTES=8388608

# Hold videos at "processing" until a faststart Lambda flips them to "ready".
# Leave unset until that Lambda exists, so S3 uploads are playable immediately.
# FASTSTART_ENABLED=true

# --- AWS S3 + CloudFront (only when STORAGE_BACKEND=s3) -----------------------
# All of these come straight from `terraform output` (see infra/README.md).
AWS_REGION=eu-west-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CloudFront distribution domain, e.g. d123abc.cloudfront.net
CLOUDFRONT_DOMAIN=
# Signed-URL playback (required for the private bucket). Private key may be raw
# PEM or base64-encoded PEM; Terraform outputs it base64-encoded.
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
# CLOUDFRONT_URL_TTL_SECONDS=21600

# --- Supabase (auth + metadata; not required for local dev) ------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required in production. Two things read it: the analysis cron sweep, and
# product analytics (/api/events). Without it analytics collects NOTHING and says
# nothing about it — no errors, no rows. See docs/ANALYTICS.md §7.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend; transactional mail like participant invites) -------------
# Sending is a no-op until RESEND_API_KEY is set, so this is optional in dev.
RESEND_API_KEY=
# Must be a verified Resend domain sender.
EMAIL_FROM=Ojo Tennis <no-reply@ojotennis.com>
# Public base URL used for links in emails.
NEXT_PUBLIC_APP_URL=https://ojotennis.com

# --- Moderation --------------------------------------------------------------
# Where content reports are emailed. Reports are always written to the
# content_reports table; this is the nudge that gets them read. Set it before
# the App Store listing goes live — the listing commits to acting in 24 hours.
MODERATION_EMAIL=

# Inbound mail forwarding (/api/inbound). Lets support@ / privacy@ reach a real
# inbox — both addresses are published in the privacy policy, the terms and the
# App Store listing, so they must not bounce.
#   RESEND_WEBHOOK_SECRET    the signing secret from the Resend webhook page (whsec_…)
#   INBOUND_FORWARD_TO       where mail is forwarded (your everyday inbox)
#   RESEND_INBOUND_API_KEY   a FULL-ACCESS Resend key. Forwarding reads the
#                            received message, so a sending-only key fails with
#                            `restricted_api_key`. Separate from RESEND_API_KEY
#                            so the send key can stay restricted.
#   INBOUND_FORWARD_FROM   must be on the verified sending domain — the original
#                          sender goes in Reply-To, not From, or it fails SPF
#   INBOUND_DOMAIN         only forward mail addressed to this domain. Resend
#                          webhooks are account-wide and cannot be scoped, so
#                          without this every project sharing the Resend account
#                          forwards every other project's inbound mail.
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_API_KEY=
INBOUND_FORWARD_TO=
INBOUND_FORWARD_FROM=Ojo Tennis <no-reply@ojotennis.com>
INBOUND_DOMAIN=ojotennis.com

# --- TwelveLabs (video AI rally segmentation) --------------------------------
# Analysis degrades to a dev stub until TWELVELABS_API_KEY is set, so it's
# optional in dev. Create a key in the TwelveLabs Playground/dashboard.
TWELVELABS_API_KEY=
# Override only if TwelveLabs changes their API base.
# TWELVELABS_BASE_URL=https://api.twelvelabs.io/v1.3

# --- Admin dashboard (/admin) ------------------------------------------------
# The single address allowed into /admin. Compared against the email on the
# Supabase session, case-insensitively. UNSET MEANS NOBODY, not everybody: a
# fresh environment (preview deploy, fork, new machine) has no dashboard at all
# until this is set deliberately. The pages 404 rather than 403 for anyone else,
# so an unauthorised visitor cannot even confirm the route exists.
ADMIN_EMAIL=

# Rates for the cost estimates on /admin/costs. Usage is measured from the
# database; these are what it gets multiplied by, so set them to what you are
# actually charged. Defaults are eu-west-1 list prices. Egress is deliberately
# not estimated — see the note on that page.
COST_S3_PER_GB_MONTH=0.023
COST_ANALYSIS_PER_MINUTE=0.033
COST_FIXED_MONTHLY=0
COST_CURRENCY=USD
