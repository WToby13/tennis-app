# --- Storage backend ---------------------------------------------------------
# "local" writes parts/videos to web/.data (no cloud account needed — the default).
# "s3" uses real S3 multipart with presigned URLs + signed CloudFront playback.
STORAGE_BACKEND=local

# Size of each multipart chunk in bytes. S3 minimum is 5 MB (except the last part).
PART_SIZE_BYTES=8388608

# Hold videos at "processing" until a faststart Lambda flips them to "ready".
# Leave unset until that Lambda exists, so S3 uploads are playable immediately.
# FASTSTART_ENABLED=true

# --- AWS S3 + CloudFront (only when STORAGE_BACKEND=s3) -----------------------
# All of these come straight from `terraform output` (see infra/README.md).
AWS_REGION=eu-west-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CloudFront distribution domain, e.g. d123abc.cloudfront.net
CLOUDFRONT_DOMAIN=
# Signed-URL playback (required for the private bucket). Private key may be raw
# PEM or base64-encoded PEM; Terraform outputs it base64-encoded.
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
# CLOUDFRONT_URL_TTL_SECONDS=21600

# --- Supabase (auth + metadata; not required for local dev) ------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend; transactional mail like participant invites) -------------
# Sending is a no-op until RESEND_API_KEY is set, so this is optional in dev.
RESEND_API_KEY=
# Must be a verified Resend domain sender.
EMAIL_FROM=Ojo Tennis <no-reply@ojotennis.com>
# Public base URL used for links in emails.
NEXT_PUBLIC_APP_URL=https://ojotennis.com

# --- TwelveLabs (video AI rally segmentation) --------------------------------
# Analysis degrades to a dev stub until TWELVELABS_API_KEY is set, so it's
# optional in dev. Create a key in the TwelveLabs Playground/dashboard.
TWELVELABS_API_KEY=
# Override only if TwelveLabs changes their API base.
# TWELVELABS_BASE_URL=https://api.twelvelabs.io/v1.3
